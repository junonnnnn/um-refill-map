<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".features.module2.StationDirectoryActivity"
            android:taskAffinity="${applicationId}.m2demo" />

        <activity-alias
            android:name=".features.module2.StationDirectoryDemo"
            android:exported="true"
            android:label="@string/m2_demo_title"
            android:targetActivity=".features.module2.StationDirectoryActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
